{
  "name": "education-scope-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MCP server for checking whether knowledge, explanations, and answers stay within Japanese school curriculum scope.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "education-scope-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:http": "node dist/src/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "import:mext": "tsx scripts/import-mext.ts",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
